{
  "name": "dcsplan",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.17.1",
  "description": "A flight planning tool for flight simulators",
  "scripts": {
    "install:backend": "cd packages/backend && uv sync",
    "lock:backend": "cd packages/backend && uv lock",
    "dev": "concurrently \"pnpm --filter frontend dev\" \"pnpm dev:backend\"",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "cd packages/backend && uv run uvicorn main:app --reload",
    "test:backend": "cd packages/backend && uv run pytest -v",
    "test:backend:watch": "cd packages/backend && uv run ptw -- -v",
    "test:frontend": "pnpm --filter frontend test",
    "test": "pnpm test:backend && pnpm test:frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15"
  }
}
