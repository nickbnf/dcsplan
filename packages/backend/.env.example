# Backend auth configuration (copy to .env for local dev). See docs/auth-and-single-origin.md
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback
SESSION_SECRET=change-me-to-a-long-random-string
# Local http dev: allow the session cookie over http
SESSION_HTTPS_ONLY=false
# Where to send the browser after login (optional)
POST_LOGIN_REDIRECT=/
